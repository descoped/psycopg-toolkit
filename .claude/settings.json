{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Edit(./**)",

      "Bash(uv sync *)",
      "Bash(uv lock *)",
      "Bash(uv tree *)",
      "Bash(uv build *)",
      "Bash(uv pip list *)",
      "Bash(uv run pytest *)",
      "Bash(uv run --all-groups pytest *)",
      "Bash(uv run ruff *)",
      "Bash(uv run --all-groups ruff *)",
      "Bash(uv run --all-groups python examples/*)",

      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git stash *)",
      "Bash(git worktree *)",
      "Bash(git rev-parse *)",

      "Bash(gh pr *)",
      "Bash(gh run *)",
      "Bash(gh issue *)",
      "Bash(gh repo view *)",
      "Bash(gh api repos/descoped/psycopg-toolkit/*)",
      "Bash(gh api repos/{owner}/{repo}/*)",

      "Bash(docker info *)",
      "Bash(docker ps *)",
      "Bash(docker images *)",
      "Bash(docker version *)",

      "Bash(npx -y --package renovate@latest renovate-config-validator *)"
    ]
  }
}
